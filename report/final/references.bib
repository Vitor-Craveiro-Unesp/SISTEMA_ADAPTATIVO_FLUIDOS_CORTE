%
% ============================================================


% ============================================================
% PADRÃO DE CHAVES
% ============================================================
%
% Caso BibTeX/Biber seja utilizado futuramente, adotar chaves
% legíveis e consistentes.
%
% Formato recomendado:
%
% sobrenomeAnoPalavra
%
% Exemplos apenas de FORMATO:
%
% autor2020Metodo
% autor2024Fluidos
%
% Esses exemplos NÃO correspondem a referências reais.
%
% ============================================================


% ============================================================
% MODELO PARA ARTIGO
% ============================================================
%
% Copiar e preencher somente com uma referência REAL:
%
% @article{CHAVE,
%   author  = {TO_BE_FILLED},
%   title   = {TO_BE_FILLED},
%   journal = {TO_BE_FILLED},
%   year    = {TO_BE_FILLED},
%   volume  = {TO_BE_FILLED},
%   number  = {TO_BE_FILLED},
%   pages   = {TO_BE_FILLED},
%   doi     = {TO_BE_FILLED}
% }
%
% ============================================================


% ============================================================
% MODELO PARA LIVRO
% ============================================================
%
% @book{CHAVE,
%   author    = {TO_BE_FILLED},
%   title     = {TO_BE_FILLED},
%   publisher = {TO_BE_FILLED},
%   address   = {TO_BE_FILLED},
%   year      = {TO_BE_FILLED}
% }
%
% ============================================================


% ============================================================
% MODELO PARA CAPÍTULO DE LIVRO
% ============================================================
%
% @incollection{CHAVE,
%   author    = {TO_BE_FILLED},
%   title     = {TO_BE_FILLED},
%   booktitle = {TO_BE_FILLED},
%   publisher = {TO_BE_FILLED},
%   year      = {TO_BE_FILLED},
%   pages     = {TO_BE_FILLED}
% }
%
% ============================================================


% ============================================================
% MODELO PARA DOCUMENTO TÉCNICO / NORMA
% ============================================================
%
% @manual{CHAVE,
%   author       = {TO_BE_FILLED},
%   organization = {TO_BE_FILLED},
%   title        = {TO_BE_FILLED},
%   year         = {TO_BE_FILLED},
%   note         = {TO_BE_FILLED}
% }
%
% ============================================================


% ============================================================
% MODELO PARA RECURSO ONLINE
% ============================================================
%
% Utilizar somente quando apropriado e verificar a forma de
% adaptação às normas ABNT.
%
% @misc{CHAVE,
%   author       = {TO_BE_FILLED},
%   title        = {TO_BE_FILLED},
%   year         = {TO_BE_FILLED},
%   howpublished = {TO_BE_FILLED},
%   note         = {Acesso em: TO_BE_FILLED}
% }
%
% ============================================================


